---
/**
 * English-first wiki home. Content cards are populated from published,
 * indexable MDX entries; no invented gameplay stats or codes.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, getRecentEntries, parseEntryId } from '~/lib/content';
import { detailPath, listPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home;
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
const categories = [
  { key: 'codes', title: 'Latest Codes', description: 'Verified codes, rewards and redemption information.', icon: 'lucide:gift', note: 'We only mark codes active after verification.' },
  { key: 'guides', title: 'Beginner Guides', description: 'New-player help, gameplay basics and practical tips.', icon: 'lucide:book-open', note: 'Begin with the getting-started guide.' },
  { key: 'powers', title: 'Power Index', description: 'Superpower references, acquisition details and comparisons.', icon: 'lucide:zap', note: 'Individual power details are being verified.' },
  { key: 'bosses', title: 'Boss Guides', description: 'Encounters, strategies and rewards once confirmed.', icon: 'lucide:swords', note: 'Boss-specific data is being verified.' },
] as const;
const gameSystems = [
  { key: 'upgrades', title: 'Upgrades', description: 'Upgrade systems, costs and progression choices.', icon: 'lucide:arrow-up-circle' },
  { key: 'base', title: 'Base', description: 'Base features, resource planning and useful strategies.', icon: 'lucide:house' },
] as const;

const loaded = await Promise.all(
  [...categories, ...gameSystems].map(async (c) => ({
    key: c.key,
    entries: (await getEntriesByCategory(c.key, locale)).filter((entry) => !entry.data.noindex).slice(0, c.key === 'powers' ? 8 : 4),
  })),
);
const entriesByCategory = Object.fromEntries(loaded.map((item) => [item.key, item.entries]));
const recent = (await getRecentEntries(locale, 30))
  .filter((entry) => !entry.data.noindex)
  .slice(0, 4);
const faq = home.faq?.items ?? [];
---

<LocaleLayout locale={locale} title={meta.title} description={meta.description} alternates={alternates} jsonLd={jsonLd}>
  <!-- 01: Hero — two columns keep the action group together beneath the left-side text.
       On desktop, the bottom of the actions aligns with the bottom of the right-side image. -->
  <section class="py-8 sm:py-12 lg:py-16" aria-labelledby="home-title">
    <div class="grid items-stretch gap-6 md:grid-cols-2 md:gap-6">
      <div class="flex min-w-0 flex-col">
        <h1 id="home-title" class="max-w-full text-balance text-xl font-bold leading-snug tracking-tight text-foreground sm:text-2xl">
          Steal a Superpower Wiki: Codes, Powers &amp; Guides
        </h1>

        <div class="mt-5 space-y-3 text-sm leading-7 text-black sm:text-base">
          <p>Steal a Superpower Wiki serves as a comprehensive guide for the game, covering gift codes, in-depth analyses of superpowers, beginner tutorials, boss strategies, leveling tips, and the latest game updates.</p>
          <p>Created by players for players, this wiki is your one-stop resource for all essential game information. Here, you can explore detailed data on superpowers, consult beginner guides and boss-defeat strategies, redeem the latest gift codes, and find practical advice on character progression and base development.</p>
        </div>

        <div class="mt-auto flex flex-wrap items-center gap-3 pt-6">
          <a href={listPath('guides', locale)} class="btn-primary inline-flex items-center gap-2">
            <Icon name="lucide:book-open" class="h-4 w-4" /> Guides
          </a>
          <a href={listPath('powers', locale)} class="btn-primary inline-flex items-center gap-2">
            <Icon name="lucide:zap" class="h-4 w-4" /> Powers
          </a>
          <a href={detailPath('codes', 'overview', locale)} class="btn-primary inline-flex items-center gap-2">
            <Icon name="lucide:gift" class="h-4 w-4" /> Codes
          </a>
          <a href="https://www.roblox.com/games/74183246285569/Steal-a-Superpower" target="_blank" rel="noopener noreferrer" aria-label="Play Steal a Superpower on Roblox (opens in a new tab)" class="btn-primary inline-flex items-center gap-2">
            <Icon name="lucide:gamepad-2" class="h-4 w-4" /> Play Game <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>

      <div class="flex min-w-0 items-end">
        <a href="https://www.roblox.com/games/74183246285569/Steal-a-Superpower" target="_blank" rel="noopener noreferrer" aria-label="Play Steal a Superpower on Roblox (opens in a new tab)" title="Play Steal a Superpower on Roblox" class="group block aspect-video w-full rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav">
          <img src="/images/steal-superpower-original-hero.webp" alt="Original fan-made Steal a Superpower Wiki banner featuring stylized fire, ice, and lightning powers" width="800" height="450" fetchpriority="high" decoding="async" class="aspect-video w-full rounded-2xl border border-border object-cover shadow-sm transition group-hover:shadow-lg group-hover:brightness-110" />
        </a>
      </div>
    </div>
  </section>

  <!-- Evidence-backed highlights: original game screenshots, not third-party image hotlinks. -->
  <section class="border-t border-border py-9 sm:py-12" aria-labelledby="featured-powers-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Verified game cards</p>
        <h2 id="featured-powers-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Featured Steal a Superpower Cards</h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">Six cards recorded from player-provided in-game screenshots. Open a card to compare its moves, rarity and displayed pack odds.</p>
      </div>
      <a href={detailPath('powers', 'verified-card-index', locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">Full powers index <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {[
        { slug: 'puncher', name: 'Puncher', rarity: 'Common', income: '$5/s', ability: 'Power Jab' },
        { slug: 'slugger', name: 'Slugger', rarity: 'Common', income: '$5/s', ability: 'Bat Swing' },
        { slug: 'brawler', name: 'Brawler', rarity: 'Common', income: '$6/s', ability: 'Headbutt' },
        { slug: 'toxic', name: 'Toxic', rarity: 'Uncommon', income: '$14/s', ability: 'Acid Spit' },
        { slug: 'hothead', name: 'Hothead', rarity: 'Uncommon', income: '$15/s', ability: 'Fire Punch' },
        { slug: 'frostbite', name: 'Frostbite', rarity: 'Rare', income: '$38/s', ability: 'Ice Shard' },
      ].map((card) => (
        <a href={detailPath('powers', card.slug, locale)} class="group min-w-0 rounded-xl border border-border bg-card p-2.5 transition hover:border-nav/60 hover:shadow-sm">
          <img src={`/images/powers/${card.slug}.webp`} alt={`${card.name} ${card.rarity} card screenshot from Steal a Superpower`} loading="lazy" decoding="async" width="360" height="480" class="aspect-[3/4] w-full rounded-lg object-contain" />
          <div class="mt-2 font-semibold group-hover:text-nav">{card.name}</div>
          <div class="mt-0.5 text-xs text-muted-foreground">{card.rarity} · {card.income}</div>
          <div class="mt-1 text-xs text-foreground">{card.ability}</div>
        </a>
      ))}
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted-foreground">Income is the value shown on a photographed card, not a guarantee of final base earnings. Screenshots reviewed November 8, 2026; stats may change after game updates.</p>
  </section>

  <!-- Developer-announced codes are not the same as codes verified to redeem today. -->
  <section class="border-t border-border py-9 sm:py-12" aria-labelledby="codes-snapshot-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Announcement evidence</p>
        <h2 id="codes-snapshot-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Steal a Superpower Codes &amp; Rewards</h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">These codes were announced by the developer in the official Roblox community. Current in-game redemption has not been independently tested.</p>
      </div>
      <a href={detailPath('codes', 'overview', locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">See all 10 codes and sources <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="mt-5 overflow-x-auto rounded-xl border border-border bg-card">
      <table class="w-full min-w-[530px] text-left text-sm">
        <thead class="border-b border-border bg-muted/40 text-xs uppercase text-muted-foreground">
          <tr><th scope="col" class="px-4 py-3">Code</th><th scope="col" class="px-4 py-3">Announced reward</th><th scope="col" class="px-4 py-3">Source</th></tr>
        </thead>
        <tbody>
          {[
            { code: '50KLIKES', reward: 'Tier III Luck, Power, Damage and Health potions' },
            { code: '30KLIKES', reward: 'Luck Potion III (3× Luck for 15 minutes)' },
            { code: '20KLIKES', reward: '3× Luck for 15 minutes' },
            { code: 'POTIONS', reward: 'Luck Potion II' },
            { code: 'GROUP', reward: 'Champion Pack' },
          ].map((item) => (
            <tr class="border-b border-border/70 last:border-b-0">
              <td class="px-4 py-3 font-mono font-semibold text-foreground">{item.code}</td>
              <td class="px-4 py-3 text-foreground">{item.reward}</td>
              <td class="px-4 py-3"><a href="https://www.roblox.com/communities/603354433/11-R-Productions" target="_blank" rel="noopener noreferrer" class="font-semibold text-nav hover:underline">Official announcement</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-muted-foreground">Announcement screenshots reviewed November 8, 2026. Announced ≠ working today. The full codes page separately labels five additional unverified reports.</p>
  </section>

  <section class="border-t border-border py-9 sm:py-12" aria-labelledby="beginner-tips-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Start here</p>
        <h2 id="beginner-tips-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Quick Beginner Tips</h2>
      </div>
      <a href={detailPath('guides', 'steal-a-superpower-getting-started', locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">Read the beginner guide <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="mt-5 grid gap-3 md:grid-cols-3">
      <article class="rounded-xl border border-border bg-card p-5">
        <h3 class="font-semibold">1. Learn your card moves</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Each superpower has different moves. Check its ability, special attack and level before deciding what to upgrade.</p>
        <a href={detailPath('powers', 'how-superpower-cards-work', locale)} class="mt-3 inline-block text-sm font-semibold text-nav hover:underline">Cards and leveling</a>
      </article>
      <article class="rounded-xl border border-border bg-card p-5">
        <h3 class="font-semibold">2. Keep base income running</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Place eligible cards on base holders to earn Cash while you fight. Check current in-game rules before assuming offline earnings.</p>
        <a href={detailPath('base', 'how-base-cash-works', locale)} class="mt-3 inline-block text-sm font-semibold text-nav hover:underline">How base Cash works</a>
      </article>
      <article class="rounded-xl border border-border bg-card p-5">
        <h3 class="font-semibold">3. Prepare for each boss</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Boss victories open new zones and lead to loot chests. Review your Power, Health and card abilities if a fight is difficult.</p>
        <a href={detailPath('bosses', 'dominus-bosses-and-zones', locale)} class="mt-3 inline-block text-sm font-semibold text-nav hover:underline">Boss and zone guide</a>
      </article>
    </div>
  </section>

    <!-- 02-05: Compact 2×2 category overview, as approved in the homepage wireframe. -->
  <section class="border-t border-border py-9 sm:py-12" aria-label="Main wiki categories">
    <div class="grid gap-4 md:grid-cols-2">
      {categories.map((section, i) => {
        const entries = entriesByCategory[section.key] ?? [];
        return (
          <article class="flex h-full flex-col rounded-xl border border-border bg-card p-5 sm:p-6" aria-labelledby={`section-${section.key}`}>
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">0{i + 2} / {section.key === 'guides' ? 'Quick Start' : section.key}</p>
            <div class="mt-3 flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-nav/10 text-nav">
                <Icon name={section.icon} class="h-5 w-5" />
              </span>
              <h2 id={`section-${section.key}`} class="text-xl font-extrabold tracking-tight sm:text-2xl">{section.title}</h2>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{section.description}</p>
            {entries.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {entries.slice(0, 3).map((entry) => {
                  const parsed = parseEntryId(entry.id);
                  if (!parsed) return null;
                  return (
                    <li>
                      <a class="inline-flex items-start gap-2 text-sm font-medium hover:text-nav hover:underline" href={detailPath(parsed.category, parsed.slug, locale)}>
                        <Icon name="lucide:arrow-right" class="mt-1 h-3 w-3 shrink-0 text-nav" />
                        {entry.data.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="mt-4 text-xs text-muted-foreground">{section.note}</p>
            )}
            <a href={section.key === 'codes' ? detailPath('codes', 'overview', locale) : listPath(section.key, locale)} class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-nav hover:underline">
              Explore {section.title} <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <!-- 06: One horizontal game-systems module. -->
  <section class="border-t border-border py-9 sm:py-12" aria-labelledby="game-systems-title">
    <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">06 / Game systems</p>
    <h2 id="game-systems-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Upgrades · Base · Progression</h2>
    <p class="mt-2 text-sm text-muted-foreground">Upgrade paths, base features and player progression guides as the information is verified.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      {gameSystems.map((item) => (
        <a href={item.key === 'codes' ? detailPath('codes', 'overview', locale) : listPath(item.key, locale)} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold transition hover:border-nav/50 hover:text-nav">
          <Icon name={item.icon} class="h-5 w-5 text-nav" /> {item.title} <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-muted-foreground" />
        </a>
      ))}
      <a href={listPath('guides', locale)} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold transition hover:border-nav/50 hover:text-nav">
        <Icon name="lucide:trending-up" class="h-5 w-5 text-nav" /> Progression <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-muted-foreground" />
      </a>
    </div>
  </section>

  <!-- 07: Separate site articles from game patch notes -->
  <section class="border-t border-border py-10 sm:py-12" aria-labelledby="updates-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">07 / What's new</p>
        <h2 id="updates-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Latest Game &amp; Wiki Updates</h2>
        <p class="mt-2 text-sm text-muted-foreground">Recently published guides and reference articles. For confirmed game changes, visit Updates.</p>
      </div>
      <a href={listPath('updates', locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">Game updates <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    {recent.length > 0 ? (
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {recent.map((entry) => {
          const parsed = parseEntryId(entry.id);
          if (!parsed) return null;
          return (
            <a class="card group p-5 transition hover:border-nav/50" href={detailPath(parsed.category, parsed.slug, locale)}>
              <p class="text-xs font-medium uppercase tracking-wide text-nav">{parsed.category}</p>
              <h3 class="mt-2 font-semibold group-hover:text-nav">{entry.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
            </a>
          );
        })}
      </div>
    ) : <p class="mt-6 rounded-xl border border-border bg-card p-6 text-sm text-muted-foreground">More verified articles will appear here as they are published.</p>}
  </section>

  <!-- 08: Visible, accessible native-HTML FAQ -->
  {faq.length > 0 && (
    <section class="border-t border-border py-10 sm:py-12" aria-labelledby="faq-title">
      <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">08 / Help</p>
      <h2 id="faq-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{home.faq.title}</h2>
      <p class="mt-2 text-sm text-muted-foreground">{home.faq.description}</p>
      <div class="mt-6 grid gap-3">
        {faq.slice(0, 6).map((item) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
              {item.question}<Icon name="lucide:chevron-down" class="h-4 w-4 shrink-0 text-muted-foreground transition group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</LocaleLayout>
