---
/**
 * English-first wiki home. Content cards are populated from published,
 * indexable MDX entries; no invented gameplay stats or codes.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, getRecentEntries, parseEntryId } from '~/lib/content';
import { detailPath, listPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home;
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
const categories = [
  { key: 'codes', title: 'Latest Codes', description: 'Verified codes, rewards and redemption information.', icon: 'lucide:gift', note: 'We only mark codes active after verification.' },
  { key: 'guides', title: 'Beginner Guides', description: 'New-player help, gameplay basics and practical tips.', icon: 'lucide:book-open', note: 'Begin with the getting-started guide.' },
  { key: 'powers', title: 'Power Index', description: 'Superpower references, acquisition details and comparisons.', icon: 'lucide:zap', note: 'Individual power details are being verified.' },
  { key: 'bosses', title: 'Boss Guides', description: 'Encounters, strategies and rewards once confirmed.', icon: 'lucide:swords', note: 'Boss-specific data is being verified.' },
] as const;
const gameSystems = [
  { key: 'upgrades', title: 'Upgrades', description: 'Upgrade systems, costs and progression choices.', icon: 'lucide:arrow-up-circle' },
  { key: 'base', title: 'Base', description: 'Base features, resource planning and useful strategies.', icon: 'lucide:house' },
] as const;

const loaded = await Promise.all(
  [...categories, ...gameSystems].map(async (c) => ({
    key: c.key,
    entries: (await getEntriesByCategory(c.key, locale)).filter((entry) => !entry.data.noindex).slice(0, c.key === 'powers' ? 8 : 4),
  })),
);
const entriesByCategory = Object.fromEntries(loaded.map((item) => [item.key, item.entries]));
const recent = (await getRecentEntries(locale, 30))
  .filter((entry) => !entry.data.noindex)
  .slice(0, 4);
const faq = home.faq?.items ?? [];
---

<LocaleLayout locale={locale} title={meta.title} description={meta.description} alternates={alternates} jsonLd={jsonLd}>
  <!-- 01: Hero — left copy and two actions, right reserved for a real game screenshot. -->
  <section class="grid items-center gap-7 py-8 sm:py-12 lg:grid-cols-2 lg:gap-10 lg:py-16" aria-labelledby="home-title">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{home.hero.badge}</p>
      <h1 id="home-title" class="mt-4 max-w-2xl text-4xl font-black leading-[1.1] tracking-tight text-foreground sm:text-5xl lg:text-6xl">{home.hero.title}</h1>
      <div class="mt-5 max-w-2xl space-y-3 text-sm leading-7 text-muted-foreground sm:text-base">
        <p><strong class="font-semibold text-foreground">Steal a Superpower</strong> is a Roblox game centered on collecting superpowers and progressing through challenges. Players explore different powers, develop their abilities, and learn how the game's bosses, upgrades, and base systems work together.</p>
        <p>This independent, fan-made wiki helps you find practical information in one place. Discover power references, beginner guides, boss strategies, code updates, and advice on upgrades and bases. Start with the guides below, explore the power index, or browse individual topics using the navigation. We add specific game details and code claims only when they can be verified.</p>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={listPath('guides', locale)} class="btn-primary inline-flex items-center gap-2">
          <Icon name="lucide:book-open" class="h-4 w-4" /> Guides
        </a>
        <a href={listPath('powers', locale)} class="btn-outline inline-flex items-center gap-2">
          <Icon name="lucide:zap" class="h-4 w-4" /> Powers
        </a>
      </div>
    </div>
    <div class="flex min-h-52 items-center justify-center rounded-2xl border border-dashed border-border bg-muted/40 p-8 sm:min-h-64 lg:min-h-80">
      <div class="flex flex-col items-center gap-3 text-center text-muted-foreground">
        <Icon name="lucide:image" class="h-12 w-12 opacity-60" />
        <p class="text-sm font-semibold">Game screenshot coming soon</p>
        <p class="max-w-xs text-xs">A verified in-game image will appear here.</p>
      </div>
    </div>
  </section>

  <!-- 02-05: Compact 2×2 category overview, as approved in the homepage wireframe. -->
  <section class="border-t border-border py-9 sm:py-12" aria-label="Main wiki categories">
    <div class="grid gap-4 md:grid-cols-2">
      {categories.map((section, i) => {
        const entries = entriesByCategory[section.key] ?? [];
        return (
          <article class="flex h-full flex-col rounded-xl border border-border bg-card p-5 sm:p-6" aria-labelledby={`section-${section.key}`}>
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">0{i + 2} / {section.key === 'guides' ? 'Quick Start' : section.key}</p>
            <div class="mt-3 flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-nav/10 text-nav">
                <Icon name={section.icon} class="h-5 w-5" />
              </span>
              <h2 id={`section-${section.key}`} class="text-xl font-extrabold tracking-tight sm:text-2xl">{section.title}</h2>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{section.description}</p>
            {entries.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {entries.slice(0, 3).map((entry) => {
                  const parsed = parseEntryId(entry.id);
                  if (!parsed) return null;
                  return (
                    <li>
                      <a class="inline-flex items-start gap-2 text-sm font-medium hover:text-nav hover:underline" href={detailPath(parsed.category, parsed.slug, locale)}>
                        <Icon name="lucide:arrow-right" class="mt-1 h-3 w-3 shrink-0 text-nav" />
                        {entry.data.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="mt-4 text-xs text-muted-foreground">{section.note}</p>
            )}
            <a href={listPath(section.key, locale)} class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-nav hover:underline">
              Explore {section.title} <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <!-- 06: One horizontal game-systems module. -->
  <section class="border-t border-border py-9 sm:py-12" aria-labelledby="game-systems-title">
    <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">06 / Game systems</p>
    <h2 id="game-systems-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Upgrades · Base · Progression</h2>
    <p class="mt-2 text-sm text-muted-foreground">Upgrade paths, base features and player progression guides as the information is verified.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      {gameSystems.map((item) => (
        <a href={listPath(item.key, locale)} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold transition hover:border-nav/50 hover:text-nav">
          <Icon name={item.icon} class="h-5 w-5 text-nav" /> {item.title} <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-muted-foreground" />
        </a>
      ))}
      <a href={listPath('guides', locale)} class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold transition hover:border-nav/50 hover:text-nav">
        <Icon name="lucide:trending-up" class="h-5 w-5 text-nav" /> Progression <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-muted-foreground" />
      </a>
    </div>
  </section>

  <!-- 07: Separate site articles from game patch notes -->
  <section class="border-t border-border py-10 sm:py-12" aria-labelledby="updates-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">07 / What's new</p>
        <h2 id="updates-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Latest Game &amp; Wiki Updates</h2>
        <p class="mt-2 text-sm text-muted-foreground">Recently published guides and reference articles. For confirmed game changes, visit Updates.</p>
      </div>
      <a href={listPath('updates', locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">Game updates <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
    </div>
    {recent.length > 0 ? (
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {recent.map((entry) => {
          const parsed = parseEntryId(entry.id);
          if (!parsed) return null;
          return (
            <a class="card group p-5 transition hover:border-nav/50" href={detailPath(parsed.category, parsed.slug, locale)}>
              <p class="text-xs font-medium uppercase tracking-wide text-nav">{parsed.category}</p>
              <h3 class="mt-2 font-semibold group-hover:text-nav">{entry.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{entry.data.description}</p>
            </a>
          );
        })}
      </div>
    ) : <p class="mt-6 rounded-xl border border-border bg-card p-6 text-sm text-muted-foreground">More verified articles will appear here as they are published.</p>}
  </section>

  <!-- 08: Visible, accessible native-HTML FAQ -->
  {faq.length > 0 && (
    <section class="border-t border-border py-10 sm:py-12" aria-labelledby="faq-title">
      <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">08 / Help</p>
      <h2 id="faq-title" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{home.faq.title}</h2>
      <p class="mt-2 text-sm text-muted-foreground">{home.faq.description}</p>
      <div class="mt-6 grid gap-3">
        {faq.slice(0, 6).map((item) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
              {item.question}<Icon name="lucide:chevron-down" class="h-4 w-4 shrink-0 text-muted-foreground transition group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</LocaleLayout>
