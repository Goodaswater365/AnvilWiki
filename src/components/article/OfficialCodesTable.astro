---
/**
 * Unified code reference table: developer-announced codes first, independently
 * unverified third-party reports below. Never imply live redemption was tested.
 */
const officialSource = 'https://www.roblox.com/communities/603354433/11-R-Productions';
const codes = [
  { code: '50KLIKES', reward: 'Tier 3 potions: 3× Luck, Power, Damage and Health', announced: '~ Nov 6, 2026', dateNote: 'Estimated from the “2d” label seen on November 8, 2026', estimated: true, official: true },
  { code: '30KLIKES', reward: 'Luck Potion III: 3× Luck for 15 minutes', announced: 'Nov 5, 2026', dateNote: 'Exact timestamp shown: 2026-11-05 11:45:42 (timezone unknown)', estimated: false, official: true },
  { code: '20KLIKES', reward: '3× Luck for 15 minutes', announced: '~ Nov 4, 2026', dateNote: 'Estimated from the “4d” label seen on November 8, 2026', estimated: true, official: true },
  { code: 'POTIONS', reward: 'Luck Potion II effect', announced: '~ Nov 2, 2026', dateNote: 'Estimated from the “6d” label seen on November 8, 2026', estimated: true, official: true },
  { code: 'GROUP', reward: 'Champion Pack', announced: 'Early Nov 2026', dateNote: 'Approximate: the post showed “1w”, not an exact date', estimated: true, official: true },
  { code: '10KCCU', reward: 'Mystery Pack (reported)', announced: 'Unknown', dateNote: 'Official announcement date not verified', estimated: false, official: false },
  { code: 'SOZFORUPDATES', reward: 'Power Potion III (reported)', announced: 'Unknown', dateNote: 'Official announcement date not verified', estimated: false, official: false },
  { code: '10KLIKES', reward: 'Power Potion III (reported)', announced: 'Unknown', dateNote: 'Official announcement date not verified', estimated: false, official: false },
  { code: '1KCCU', reward: 'Power Potion II (reported)', announced: 'Unknown', dateNote: 'Official announcement date not verified', estimated: false, official: false },
  { code: 'DISCORD', reward: 'Legend Pack (reported)', announced: 'Unknown', dateNote: 'Official announcement date not verified', estimated: false, official: false },
];
---
<section class="not-prose my-7" aria-labelledby="official-codes-heading">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 id="official-codes-heading" class="text-xl font-extrabold tracking-tight sm:text-2xl">Steal a Superpower Codes</h2>
    <span class="text-xs text-muted-foreground">Source reviewed Nov 8, 2026</span>
  </div>
  <div class="overflow-x-auto rounded-xl border border-border bg-card">
    <table class="w-full min-w-[600px] border-collapse text-left text-sm">
      <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-wider text-muted-foreground">
        <tr>
          <th scope="col" class="px-3 py-3 font-semibold sm:px-4">Code</th>
          <th scope="col" class="px-3 py-3 font-semibold sm:px-4">Reward</th>
          <th scope="col" class="px-3 py-3 font-semibold sm:px-4">Announced</th>
          <th scope="col" class="px-3 py-3 font-semibold sm:px-4">Source</th>
        </tr>
      </thead>
      <tbody>
        {codes.map((item) => (
          <tr class="border-b border-border/70 last:border-b-0">
            <td class="px-3 py-3 align-middle sm:px-4">
              <div class="inline-flex items-center gap-2">
                <code class="whitespace-nowrap rounded-lg border border-border bg-muted/60 px-2.5 py-2 font-mono text-sm font-semibold text-foreground">{item.code}</code>
                <button type="button" data-copy-code={item.code} aria-label={`Copy code ${item.code}`} title={`Copy ${item.code}`} class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border text-foreground transition hover:border-nav hover:bg-nav/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nav">
                  <svg data-icon-copy aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
                  <svg data-icon-check aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4 w-4 text-green-600"><path d="m5 12 4 4L19 6"/></svg>
                </button>
              </div>
            </td>
            <td class="px-3 py-3 align-middle text-foreground sm:px-4">{item.reward}</td>
            <td class="px-3 py-3 align-middle text-muted-foreground sm:px-4"><span title={item.dateNote} class="whitespace-nowrap">{item.announced}</span></td>
            <td class="px-3 py-3 align-middle sm:px-4">{item.official ? <a href={officialSource} target="_blank" rel="noopener noreferrer" title="Developer announcement in the Roblox community" class="font-semibold text-nav underline-offset-4 hover:underline">Official ↗</a> : <span class="font-medium text-muted-foreground" title="Not confirmed by a developer announcement">Unverified</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted-foreground"><strong>~ = estimated announcement date.</strong> Dates without ~ are backed by a visible timestamp. “Official” = confirmed by a developer announcement. “Unverified” = not yet confirmed by an official source. Neither label guarantees that the code currently works. <span id="codes-copy-feedback" class="sr-only" role="status" aria-live="polite"></span></p>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.dataset.copyCode;
      if (!code) return;
      const feedback = document.getElementById('codes-copy-feedback');
      try {
        await navigator.clipboard.writeText(code);
        if (feedback) feedback.textContent = `Copied ${code}`;
        const copyIcon = button.querySelector<SVGElement>('[data-icon-copy]');
        const checkIcon = button.querySelector<SVGElement>('[data-icon-check]');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        button.setAttribute('aria-label', `Copied ${code}`);
        window.setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          button.setAttribute('aria-label', `Copy code ${code}`);
        }, 1600);
      } catch {
        if (feedback) feedback.textContent = `Copy failed for ${code}. Select the code text to copy it manually.`;
      }
    });
  });
</script>
